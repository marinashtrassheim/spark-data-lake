LOG_LEVEL=INFO

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=data-lake

RAW_PATH=s3a://data-lake/raw/
BRONZE_PATH=s3a://data-lake/bronze/
BRONZE_CHECKPOINT_PATH=s3a://data-lake/meta/bronze_checkpoint/
BRONZE_DQE_PATH=s3a://data-lake/dqe_bronze/
LATE_EVENT_GRACE_HOURS=24
SILVER_PATH=s3a://data-lake/silver/
DQE_PATH=s3a://data-lake/dqe_errors/
GOLD_PATH=s3a://data-lake/gold/
SILVER_CHECKPOINT_PATH=s3a://data-lake/meta/silver_checkpoint/
GOLD_CHECKPOINT_PATH=s3a://data-lake/meta/gold_checkpoint/

# Generator (docker compose --profile tools run generator)
RAW_PREFIX=raw
GENERATOR_FILES_PER_DAY=50
GENERATOR_INVALID_RATIO=0.1
